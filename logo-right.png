<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>مهرجان حبة حنطة</title>
  <link rel="icon" href="/public/logo-left.png" type="image/png">
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body class="home-page">
  <header class="site-header">
    <a href="/" class="logo-link" aria-label="الرئيسية">
      <img src="/public/logo-left.png" class="header-logo" alt="شعار المهرجان">
    </a>
    <div class="header-title">
      <h2>مهرجان حبة حنطة</h2>
    </div>
    <div class="header-right">
      <nav class="header-actions" aria-label="روابط الموقع">
        <a class="btn-nav login" href="https://docs.google.com/forms/d/e/1FAIpQLSfJMLvFlnHMETFObqLkTVEtno1MXSQARGNPfLCVdzI8hrHMsw/viewform?usp=send_form">إنشاء حساب</a>
        <a class="btn-nav" href="/c/9d4acaf0-6607-83ea-b660-4b9e88d19bd5">تسجيل دخول</a>
      </nav>
   <img src="/public/logo-right.png" class="header-logo" alt="شعار الكنيسة">
    </div>
  </header>

  <main class="home-hero">
    <section class="hero-panel">
      <div class="hero-kicker">مهرجان 2026</div>
      <h1 class="hero-title">سجّل بياناتك<br>واختار نشاطك</h1>
      
      <div class="hero-actions">
    <a class="btn" href="https://docs.google.com/forms/d/e/1FAIpQLSfJMLvFlnHMETFObqLkTVEtno1MXSQARGNPfLCVdzI8hrHMsw/viewform?usp=send_form">إنشاء حساب</a>
        <a class="btn secondary" href="/c/9d4acaf0-6607-83ea-b660-4b9e88d19bd5">عندي حساب</a>
      </div>
    </section>

    <aside class="hero-card">
      <img src="/public/logo mahragan.png" alt="شعار مهرجان حبة حنطة">
      
      <a class="teacher-small teacher-link" href="/c/2f6ccaf0-8809-83ea-b660-6d9e88d19bd7">دخول الخدام</a>
    </aside>
  </main>

  <footer class="app-footer" dir="ltr">© 2026 David Hany. All rights reserved.</footer>
</body>
</html>
